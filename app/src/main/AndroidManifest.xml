<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- 在线更新：下载完 APK 后由用户确认安装，需系统「安装未知来源应用」开关 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 搜索页检索通讯录联系人；运行时按需申请，未授权时不影响其它搜索功能 -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
        快捷键设置：实体按键绑定存在 Settings.System 的自定义键里（如 func1_short_press_package）。
        Android 只允许第三方应用写 Settings.System 白名单内的键，这些自定义键不在白名单里，
        所以「修改系统设置」权限也写不进去，必须 WRITE_SECURE_SETTINGS。
        该权限不能弹窗申请，也不随 APK 安装自动获得，需用户用 ADB 一次性授予：
            adb shell pm grant com.duolauncher android.permission.WRITE_SECURE_SETTINGS
        未授权时设置页会给出这条命令并允许复制，功能不报错、只是写不进去。
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- 状态徽标里的蜂窝信号格 / 双卡双排：读取真实信号强度（首次启动弹一次授权框；
         拒绝后可在「设置 → iOS 风格状态栏 → 电话权限」重新开启，未授权时回退为单卡满格） -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- 壁纸自动切换：设置系统主屏壁纸（安装即授予的普通权限，图片来自用户本机选择） -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- 展开通知栏 / 快捷开关（下滑手势）。多数 ROM 上是 normal 权限，安装即授予 -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:name=".DuoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/DuoTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|fontScale"
            android:theme="@style/DuoTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            快捷键转发：系统原生快捷键页只能用「当前用户」的应用写绑定，分身应用在那里选不到。
            这里把 6 个「分身 N」声明成普通桌面入口（带 LAUNCHER category），
            系统原生页面的应用列表按 LAUNCHER activity 枚举，于是用户能直接选到它们；
            绑定由系统自己写入（第三方应用没有写这些设置项的权限），按键触发后进
            ShortcutProxyActivity，再按槽位表打开真正的分身应用。
            槽位数量必须与 ShortcutManager.SLOT_COUNT 一致。
        -->
        <activity
            android:name=".ShortcutProxyActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />
        <activity-alias android:name=".ShortcutProxySlot1"
            android:targetActivity=".ShortcutProxyActivity"
            android:exported="true"
            android:label="@string/clone_slot_1">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".ShortcutProxySlot2"
            android:targetActivity=".ShortcutProxyActivity"
            android:exported="true"
            android:label="@string/clone_slot_2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".ShortcutProxySlot3"
            android:targetActivity=".ShortcutProxyActivity"
            android:exported="true"
            android:label="@string/clone_slot_3">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".ShortcutProxySlot4"
            android:targetActivity=".ShortcutProxyActivity"
            android:exported="true"
            android:label="@string/clone_slot_4">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".ShortcutProxySlot5"
            android:targetActivity=".ShortcutProxyActivity"
            android:exported="true"
            android:label="@string/clone_slot_5">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".ShortcutProxySlot6"
            android:targetActivity=".ShortcutProxyActivity"
            android:exported="true"
            android:label="@string/clone_slot_6">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 在线更新下载的 APK 放在 cache/updates/，只临时授权给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.duolauncher.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".service.DuoNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".service.DuoLockService"
            android:exported="true"
            android:label="@string/duo_lock_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/duo_lock_service" />
        </service>
    </application>
</manifest>
